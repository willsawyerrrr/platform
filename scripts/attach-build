#!/usr/bin/env node
// Attach a processed build to the app's editable App Store version, creating
// the version if none exists, via the App Store Connect API.
//
// Usage: attach-build <key.p8> <bundle-id> <version> <build-number>
//
// Reads `ASC_KEY_ID` and `ASC_ISSUER_ID` from the environment.
import { createPrivateKey, sign } from "node:crypto";
import { readFileSync } from "node:fs";

const [keyPath, bundleId, version, buildNumber] = process.argv.slice(2);
const { ASC_KEY_ID, ASC_ISSUER_ID } = process.env;
if (!keyPath || !bundleId || !version || !buildNumber || !ASC_KEY_ID || !ASC_ISSUER_ID) {
  console.error("usage: attach-build <key.p8> <bundle-id> <version> <build-number> (needs ASC_KEY_ID, ASC_ISSUER_ID)");
  process.exit(1);
}

const base64url = (value) => Buffer.from(value).toString("base64url");
const key = createPrivateKey(readFileSync(keyPath));

function token() {
  const header = base64url(JSON.stringify({ alg: "ES256", kid: ASC_KEY_ID, typ: "JWT" }));
  const claims = base64url(
    JSON.stringify({ iss: ASC_ISSUER_ID, aud: "appstoreconnect-v1", exp: Math.floor(Date.now() / 1000) + 600 }),
  );
  const signature = sign("sha256", Buffer.from(`${header}.${claims}`), { key, dsaEncoding: "ieee-p1363" });
  return `${header}.${claims}.${signature.toString("base64url")}`;
}

async function api(method, path, body) {
  const response = await fetch(`https://api.appstoreconnect.apple.com${path}`, {
    method,
    headers: { Authorization: `Bearer ${token()}`, "Content-Type": "application/json" },
    body: body && JSON.stringify(body),
  });
  const text = await response.text();
  if (!response.ok) throw new Error(`${method} ${path}: ${response.status} ${text}`);
  return text ? JSON.parse(text) : {};
}

const query = (params) => new URLSearchParams(params).toString();

const apps = await api("GET", `/v1/apps?${query({ "filter[bundleId]": bundleId })}`);
if (apps.data.length !== 1) throw new Error(`Expected one app with bundle ID ${bundleId}, found ${apps.data.length}`);
const appId = apps.data[0].id;

let build;
for (let attempt = 0; attempt < 60; attempt++) {
  const builds = await api(
    "GET",
    `/v1/builds?${query({
      "filter[app]": appId,
      "filter[version]": buildNumber,
      "filter[preReleaseVersion.version]": version,
    })}`,
  );
  build = builds.data[0];
  if (build?.attributes.processingState === "VALID") break;
  if (build && build.attributes.processingState !== "PROCESSING") {
    throw new Error(`Build ${buildNumber} is ${build.attributes.processingState}`);
  }
  console.log(`Waiting for build ${buildNumber} to finish processing...`);
  await new Promise((resolve) => setTimeout(resolve, 30_000));
}
if (build?.attributes.processingState !== "VALID") throw new Error(`Build ${buildNumber} did not finish processing`);

const editable = ["PREPARE_FOR_SUBMISSION", "DEVELOPER_REJECTED", "REJECTED", "METADATA_REJECTED", "INVALID_BINARY"];
const versions = await api(
  "GET",
  `/v1/apps/${appId}/appStoreVersions?${query({
    "filter[platform]": "IOS",
    "filter[appStoreState]": editable.join(","),
  })}`,
);
let appStoreVersion = versions.data.find((v) => v.attributes.versionString === version);
if (!appStoreVersion) {
  appStoreVersion = (
    await api("POST", "/v1/appStoreVersions", {
      data: {
        type: "appStoreVersions",
        attributes: { platform: "IOS", versionString: version },
        relationships: { app: { data: { type: "apps", id: appId } } },
      },
    })
  ).data;
  console.log(`Created App Store version ${version}`);
}

await api("PATCH", `/v1/appStoreVersions/${appStoreVersion.id}/relationships/build`, {
  data: { type: "builds", id: build.id },
});
console.log(`Attached build ${buildNumber} to App Store version ${version}`);
